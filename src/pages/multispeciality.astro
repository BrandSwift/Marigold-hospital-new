---
import Pagebanner from "../components/pagebanner.astro";
import Layout from "../layouts/Layout.astro";
import Special from "../components/special.jsx";


---

<Layout title="Leading Multispeciality Hospital in JP Nagar & BTM II Stage, Bangalore | Marigold Hospitals" canonical="https://www.marigoldhospitals.com/multispeciality/" link="">
    <div class="section-pad">
        <div class="container">
            <Pagebanner title="Speciality Service" img1="https://ik.imagekit.io/marigoldhospital/Marigold%20hospital/public/images/ICU12-min.webp?updatedAt=1746179045558" img2="https://ik.imagekit.io/marigoldhospital/Marigold%20hospital/public/images/ICU3-min.webp?updatedAt=1746179045722" content="" />
        </div>
    </div>

    <section class="section-pad sp-wrap">
        <div class="bg">
            <img src="https://ik.imagekit.io/marigoldhospital/Marigold%20hospital/public/bluewave.webp?updatedAt=1746179022962" alt="marigold-hospital-bluewave6">
        </div>
        <div class="container">
            <Special client:load />
        </div>
    </section>


    
  
</Layout>

<style>
    
    .sp-wrap{
        position: relative;
       
    }

</style>