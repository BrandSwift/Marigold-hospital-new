<div class="diagnostics section-pad">
    <div class="container">
        <Pagebanner title="Diagnostics" img1="https://ik.imagekit.io/marigoldhospital/Marigold%20hospital/public/images/Xray.4-min.webp?updatedAt=1746179046680" img2="https://ik.imagekit.io/marigoldhospital/Marigold%20hospital/public/images/Lab.4-min.webp?updatedAt=1746179046164" content="" />
    </div>
</div>

<div class="section-pad diagnos">
    <div class="bg">
        <img src="https://ik.imagekit.io/marigoldhospital/Marigold%20hospital/public/bluewave.webp?updatedAt=1746179022962" alt="marigold-hospital-best-diagnostics">
    </div>
    <div class="container">
        <div class="section-title">

        </div>
        <Diagnosis client:load />
    </div>
</div>


</Layout>

<style lang="scss">
.diagnos{
    position:relative;
}
</style>



