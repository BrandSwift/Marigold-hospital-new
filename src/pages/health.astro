<Layout title="Comprehensive Health Services at Marigold Hospitals | Your Trusted Care Partner" canonical="https://www.marigoldhospitals.com/health/" link="">
<div class="container">
    <div class="section-pad">
      <Pagebanner title="Health Packages" img1="https://ik.imagekit.io/marigoldhospital/Marigold%20hospital/public/images/Xray.4-min.webp?updatedAt=1746179046680" img2="https://ik.imagekit.io/marigoldhospital/Marigold%20hospital/public/images/Lab.4-min.webp?updatedAt=1746179046164" />

      
    </div>
</div>


  <div class="section-pad healthy">
    <div class="bg">
        <img src="https://ik.imagekit.io/marigoldhospital/Marigold%20hospital/public/bluewave.webp?updatedAt=1746179022962" alt="marigold-hospital-bluewave-healthy">
    </div>
    <div class="container">
        <Healthtile client:load />
       </div>
  </div>


</Layout>

<style lang="scss">
   .healthy{
    position: relative;
   }
</style>